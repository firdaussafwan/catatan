APP_NAME=Catatan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: one SQLite file (database/database.sqlite). Back it up by copying it. ---
DB_CONNECTION=sqlite

# --- Session: stay signed in for 30 days (43200 min). "Remember me" cookie lasts longer. ---
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
# Set to true once you serve the app over HTTPS:
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Catatan ---
# The /setup page (create the first account) only works while no user exists AND this is true.
# Set to false after creating your account.
ALLOW_SETUP=true

# --- SMTP (used for "Forgot password" emails). Fill these in. ---
# While MAIL_MAILER=log, reset emails are written to storage/logs/laravel.log instead of sent.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=null
# Port 587 -> MAIL_SCHEME=null (STARTTLS) | Port 465 -> MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
